<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Shf.Cli</RootNamespace>
    <AssemblyName>shf</AssemblyName>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-shf</ToolCommandName>
    <PackageId>StrawhatsCompany.SHFramework.Cli</PackageId>
    <Version>0.3.4</Version>
    <Authors>Strawhats Company</Authors>
    <Description>Laravel-Artisan-style code generator for Strawhats Framework services. Scaffolds features, endpoints, entities, providers, and persistence projects.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/StrawhatsCompany/shf-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/StrawhatsCompany/shf-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>shf;codegen;cli;dotnet-tool;cqrs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.50.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\**\*.sbn">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shf.Cli.Tests" />
  </ItemGroup>

</Project>
